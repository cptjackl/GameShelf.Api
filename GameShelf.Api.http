@host = http://localhost:5262


### Get all Games
GET {{host}}/games/
Accept: application/json

### Get game by Id
GET {{host}}/games/1
Accept: application/json 

### Create a game
POST {{host}}/games
Content-Type: application/json

{"title": "", "platform":"pc","releaseYear": 2026}

### Update a game by id
PUT {{host}}/games/1
Content-Type: application/json

{"title": "Hades II", "platform":"pc","releaseYear": 2024}

### Delete a game
DELETE {{host}}/games/5


### Add Hades
POST {{host}}/games
Content-Type: application/json

{
  "title": "Hades",
  "platform": "PC",
  "releaseYear": 2020
}

### Add Celeste
POST {{host}}/games
Content-Type: application/json

{
  "title": "Celeste",
  "platform": "Nintendo Switch",
  "releaseYear": 2018
}

### Add Stardew Valley
POST {{host}}/games
Content-Type: application/json

{
  "title": "Stardew Valley",
  "platform": "PC",
  "releaseYear": 2016
}

### Add Portal 2
POST {{host}}/games
Content-Type: application/json

{
  "title": "Portal 2",
  "platform": "PC",
  "releaseYear": 2011
}